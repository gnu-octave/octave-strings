# before cross building, pre-build at least $(TEXIFILE) natively,
# e.g. with targets 'doc', 'html', or 'prebuild'

PCRE_CXXFLAGS ?= @PCRE_CFLAGS@
PCRE_LIBS ?= @PCRE_LIBS@

MKOCTFILE ?= @MKOCTFILE@
OCTAVE_CONFIG ?= @OCTAVE_CONFIG@
GREP      ?= @GREP@

ARCHDIR   := "$(shell $(OCTAVE_CONFIG) -p CANONICAL_HOST_TYPE)-$(shell $(OCTAVE_CONFIG) -p API_VERSION)"

.PHONY: all clean distclean maintainer-clean

all: pcregexp.oct archtests

%.oct: %.cc
	$(MKOCTFILE) -o $@ $< $(PCRE_CXXFLAGS) $(PCRE_LIBS)

CC_SOURCES  := $(wildcard *.cc)
CPP_TST_SOURCES := $(shell $(GREP) --files-with-matches '^%!' $(CC_SOURCES))
TST_SOURCES := $(patsubst %.cc,../inst/$(ARCHDIR)/%.cc-tst,$(CPP_TST_SOURCES))

.PHONY: archtests
archtests: $(TST_SOURCES)

.PHONY: cleanarchtests
cleanarchtests:
	rm -f $(TST_SOURCES)

../inst/$(ARCHDIR):
	@mkdir -p "$@"

../inst/$(ARCHDIR)/%.cc-tst: %.cc | ../inst/$(ARCHDIR)
	@echo "Extracting tests from $< ..."
	@$(RM) -f "$@" "$@-t"
	@(      echo "## Generated from $<"; \
	        $(GREP) '^%!' "$<") > "$@"


clean: cleanarchtests
	$(RM) *.o octave-core *.oct *~
	test -e ../inst/$(ARCHDIR) && rmdir ../inst/$(ARCHDIR) || true

distclean: clean
	$(RM) config.h config.log config.status Makefile oct-alt-includes.h
	$(RM) -r autom4te.cache

maintainer-clean: distclean
	$(RM) configure config.h.in aclocal.m4
